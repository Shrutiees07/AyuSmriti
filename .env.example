# AyuSmriti Application Environment Configuration
# Offline Cognitive Companion for Elderly Care

# Application Identification
VITE_APP_TITLE="AyuSmriti - Cognitive Companion"
VITE_APP_VERSION="1.0.0"

# Offline Storage & Cache Keys
VITE_STORAGE_KEY_PREFIX="ayusmriti_offline_v1"
VITE_STORAGE_SYNC_INTERVAL_MS=30000

# Text-to-Speech Accessibility Defaults
VITE_SPEECH_VOICE_LANG="en-US"
VITE_SPEECH_DEFAULT_PITCH=1.0
VITE_SPEECH_DEFAULT_RATE=0.85

# Cognitive Engine Settings
VITE_COGNITIVE_MAX_LEVEL=5
VITE_COGNITIVE_DRIFT_ALERT_THRESHOLD=0.25

# Caregiver Alert Webhook (Optional online sync endpoint)
VITE_CAREGIVER_SYNC_ENDPOINT="https://api.ayusmriti.health/v1/sync"
